# Private deployment configuration. Never commit .env or real secrets.
HOST=127.0.0.1
PORT=4173
DATA_DIR=.mireva-data
# Enable these only after configuring your HTTPS reverse proxy:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://design.example.com
ALLOW_REGISTRATION=1
# Production defaults to no anonymous room creation.
# ALLOW_ANONYMOUS_ROOMS=0
# CREATE_KEY=optional-private-legacy-room-creation-key
# METRICS_KEY=long-random-operator-secret
# DATA_KEY=32-byte-key-as-64-hex-characters-or-base64
# CORS_ORIGINS=https://another-explicitly-trusted-origin.example

# Production mail: SMTP with STARTTLS, or implicit TLS with SMTP_SECURE=1.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=service-user
# SMTP_PASSWORD=replace-secret
# MAIL_FROM=Mireva Studio <design@example.com>
# Alternative delivery adapter:
# MAIL_WEBHOOK_URL=https://your-mail-service.example/send
# MAIL_WEBHOOK_KEY=replace-secret

# OIDC redirects to PUBLIC_ORIGIN/auth/oidc/company/callback
OIDC_PROVIDERS=[]
# OIDC_PROVIDERS=[{"id":"company","name":"Company sign-in","issuer":"https://identity.example.com/realms/design","clientId":"mireva","clientSecret":"replace-secret","tokenAuth":"client_secret_basic"}]

AI_PROVIDERS=[]
# AI_PROVIDERS=[{"id":"design-model","name":"Design model","kind":"chat","url":"https://model.example.com/v1/chat/completions","model":"your-vision-model","key":"replace-secret","vision":true,"timeout":90000}]
# kind: chat | responses | ollama. URLs are full endpoints; HTTPS in production.
# Legacy one-provider settings also work:
# AI_URL=https://model.example.com/v1/chat/completions
# AI_MODEL=your-model
# AI_KEY=replace-secret
